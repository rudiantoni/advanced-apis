# --- Docker (local runtime data) ---
**/docker/dev/data/

# --- Gradle ---
**/.gradle/
**/build/

# --- Java ---
**/*.class
**/out/

# Build artifacts (never commit; wrapper and New Relic agent JARs are exceptions)
**/*.jar
**/*.war
**/*.ear
!**/gradle/wrapper/gradle-wrapper.jar
!**/newrelic.jar

# --- Logs & temp ---
*.log
logs/
*~
*.swp
*.tmp

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache/
bin/
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets / local env ---
.env
.env.*
!.env.example

# Spring local profile (machine-specific, not committed)
**/application-local.yml
**/application-local.yaml
**/application-local.properties
