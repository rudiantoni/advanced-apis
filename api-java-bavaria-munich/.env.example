# Copy to `.env.local` (gitignored). Used by the IDE / shell (`cloud` profile) and by Docker Compose.
# Compose overrides DATABASE_HOST so the API container reaches Postgres by service name.
SERVER_PORT=8080
CONTEXT_PATH=/api
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_db_name
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_MS=3600000
PUBLIC_ROUTES=[{"route":"^/swagger-ui(/.*)?$"},{"route":"^/swagger-ui\\.html$"},{"route":"^/v3/api-docs(/.*)?$"},{"route":"^/open(/.*)?$"},{"route":"^/auth/login$"},{"route":"^/users$","methods":["POST"]}]
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=api-java-bavaria-munich
NEW_RELIC_AGENT_ENABLED=true
